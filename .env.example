# --- Neon PostgreSQL (optional, for event rows table) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Neon Object Storage / S3 (optional, for snapshots, events.json, video) ---
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH.storage.c-9.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=YOUR_NEON_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_NEON_SECRET_KEY
AWS_REGION=us-east-2
S3_BUCKET=alpr-snapshots

# --- Service Configuration ---
SERVICE_TOKEN=your-secure-random-token-here
SERVICE_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
VIDEO_DIR=../CPK-Management/public/videos
RTSP_BASE=rtsp://127.0.0.1:8554

# --- Camera 1 Configuration (your live stream) ---
# RTSP URL for your camera at http://10.1.19.78:8888/live/
# Note: If your camera serves RTSP, use rtsp://10.1.19.78:554/... or check camera docs
CAMERA_1_RTSP_URL=rtsp://10.1.19.78:554/stream1
CAMERA_1_NAME=Main Entrance Camera
CAMERA_1_LOCATION=Building A - Main Gate

# --- baaqi defaults, na chhedein ---
WS_PORT=8765

# --- Stage 2 AI Vision Worker (Neon AI Gateway, optional) ---
AI_GATEWAY_BASE_URL=https://YOUR_BRANCH_API_URL
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_KEY
AI_MODEL=gpt-5-mini